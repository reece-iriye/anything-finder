# ===== App =====
APP_IP=127.0.0.1
APP_PORT=9022
APP_LOG_LEVEL=info

# ===== LLM (self-hosted vLLM, OpenAI-compatible) =====
# Default model is a ~7B quantized Qwen sized for a 16 GB GPU since I have a 5060TI.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_BASE_URL=http://vllm-service.llm.svc.cluster.local:8000/v1
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional per-role overrides (fall back to LLM_MODEL / LLM_TEMPERATURE).
# LLM_MODEL_INTENT=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_MODEL_SEARCH=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_MODEL_SYNTHESIZE=Qwen/Qwen2.5-7B-Instruct-AWQ
# LLM_TEMPERATURE_SYNTHESIZE=0.4

# ===== Checkpointer (Postgres) =====
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/anything_finder

# ===== Nominatim (geocoding) =====
NOMINATIM_USE_EXTERNAL_API=false
NOMINATIM_USE_KUBERNETES_WITH_GEOSEARCH_NAMESPACE=false
# NOMINATIM_BASE_URL=http://nominatim-service:8080
NOMINATIM_TIMEOUT_SECONDS=2.0

# ===== Overpass (POI lookup) =====
OVERPASS_USE_EXTERNAL_API=false
OVERPASS_USE_KUBERNETES_WITH_GEOSEARCH_NAMESPACE=false
# OVERPASS_BASE_URL=http://overpass-service:8080
OVERPASS_TIMEOUT_SECONDS=3.0
