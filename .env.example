# ===== App =====
APP_IP=127.0.0.1
APP_PORT=9022
APP_LOG_LEVEL=info

# ===== LLM backend =====
# Three modes: vllm | claude (default for compose) | lora

# -- claude: Anthropic API (used by compose.yaml) ---------------------------
LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_CLAUDE=claude-sonnet-4-6              # default when LLM_BACKEND=claude
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# -- vllm: self-hosted vLLM (OpenAI-compatible API) --------------------------
# LLM_BACKEND=vllm
# LLM_BASE_URL=http://vllm-service.llm.svc.cluster.local:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ    # swap to Qwen/Qwen3-27B on a bigger GPU
# Per-role override (e.g. use a larger model just for the agent):
# LLM_MODEL_AGENT=Qwen/Qwen3-27B

# -- lora: vLLM serving a trained LoRA adapter ------------------------------
# Train with `make lora-data` then `make lora-train` (see the README
# "Fine-tuning on brev.dev" section), then serve via the `vllm` service in
# compose.claude.yaml with the adapter mounted at /adapters/af-lora.
# LLM_BACKEND=lora
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL_LORA=af-lora   # required: the served adapter name (--lora-modules)
#                          # or an HF repo path (<hf-username>/<lora-repo>)

# ===== Agent config =====
FOOD_PREFERENCES_DIR=data/preferences
HOME_CITY=Dallas
HOME_STATE=TX

# ===== Telemetry (optional) =====
# Set AF_TRACE_DIR to capture one JSON per agent run under <dir>/<mode>/.
# `make dev` and compose.claude.yaml set this automatically.
# AF_TRACE_DIR=telemetry
# AF_TRACE_MODE overrides the mode subdir (default: derived from LLM_BACKEND —
# claude | raw-open-source | finetuned-open-source).
# AF_TRACE_MODE=claude
#
# `make trace` opens the telemetry console (query the agent + browse traces).
# It proxies queries to this API base:
# AF_API_BASE=http://localhost:9022
#
# The `make compare-run-*` targets set AF_TRACE_DIR themselves, so each captured
# eval row leaves a trace; `make traces-freeze` then bundles them into the
# committed data/traces/<mode>.jsonl.gz, and `make compare` renders the report.

# ===== Remote GPU box + Hugging Face (fine-tuning) =====
# This repo trains on a brev.dev box (see `make lora-train-remote`); HF_TOKEN is
# forwarded there for gated base repos and for pushing the finished adapter.
# HF_TOKEN=hf_...
# HF_REPO=<hf-username>/restaurant-finder-qwen25-7b-lora
# BREV_HOST=my-brev-box          # ssh target or ssh_config alias
# BREV_DIR=anything-finder       # remote checkout path

# ===== Checkpointer (Postgres) =====
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/anything_finder

# ===== Nominatim (geocoding) =====
NOMINATIM_USE_EXTERNAL_API=false
NOMINATIM_USE_KUBERNETES_WITH_GEOSEARCH_NAMESPACE=false
# NOMINATIM_BASE_URL=http://nominatim-service:8080
NOMINATIM_TIMEOUT_SECONDS=2.0

# ===== Overpass (POI lookup) =====
OVERPASS_USE_EXTERNAL_API=false
OVERPASS_USE_KUBERNETES_WITH_GEOSEARCH_NAMESPACE=false
# OVERPASS_BASE_URL=http://overpass-service:8080
OVERPASS_TIMEOUT_SECONDS=3.0
